root = true

# Conventions d'édition partagées (aligne l'éditeur sur .gitattributes + pre-commit).
# N'affecte QUE les fichiers édités/sauvegardés — ne renormalise rien de committé.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python : ruff impose 4 espaces et 88 colonnes (cf. .vscode/settings.json).
[*.py]
indent_size = 4
max_line_length = 88

# Scripts Windows : CRLF obligatoire (cohérent avec .gitattributes).
[*.{bat,ps1}]
end_of_line = crlf

# Makefile : tabulations obligatoires.
[Makefile]
indent_style = tab
