# ============================================
# APPLICATION
# ============================================
APP_NAME=Cyber-Vault
APP_ENV=production  # development | staging | production
SECRET_KEY=  # generate: openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/cybervault

# ============================================
# CORS / FRONTEND
# ============================================
ALLOWED_ORIGINS=["https://cyberscanapp.com"]
FRONTEND_URL=https://cyberscanapp.com

# ============================================
# SÉCURITÉ
# ============================================
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ============================================
# MONITORING
# ============================================
SENTRY_DSN=https://xxx@sentry.io/projet

# ============================================
# STRIPE (LIVE en prod, TEST en staging)
# ============================================
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
ADDON_EXTRA_SITES_STRIPE_PRICE_ID=price_xxx
ADDON_EXTRA_SITES_COUNT=5
ADDON_EXTRA_SITES_PRICE_EUR=900

# ============================================
# EMAIL — Resend (préféré)
# ============================================
RESEND_API_KEY=re_xxx
RESEND_FROM=CyberScan <no-reply@cyberscanapp.com>

# ============================================
# EMAIL — SMTP (fallback local)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ============================================
# CONTACT
# ============================================
CONTACT_EMAIL=contact@cyberscanapp.com

# ============================================
# AWS S3
# ============================================
S3_BUCKET_NAME=cyberscan-uploads
AWS_REGION=eu-west-3
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (env vars standard ou IAM role ECS)

# Analyse antivirus des fichiers deposes (GuardDuty Malware Protection for S3).
# NE PASSER A true QU'APRES avoir active Malware Protection sur le bucket ET
# verifie que les objets sont bien etiquetes : sinon chaque depot reste bloque
# en "en_analyse" et plus aucun livrable n'est telechargeable.
ANTIVIRUS_DEPOT_ACTIF=false

# ============================================
# REDIS (optionnel)
# ============================================
# Si défini : jobstore APScheduler + (futur) rate-limiting partagés.
# Absent → fallback in-memory (mono-instance uniquement).
REDIS_URL=  # ex: redis://localhost:6379/0

# ============================================
# HIBP (HaveIBeenPwned breach checker)
# ============================================
HIBP_API_KEY=  # https://haveibeenpwned.com/API/Key

# ============================================
# PHISHING SIMULATION
# ============================================
# DOIT inclure /api/v1 : les URLs de tracking sont f"{PHISHING_BASE_URL}/phishing/t/..."
# Sans /api/v1 -> 404 et tracking mort en silence. En local : http://localhost:8000/api/v1
PHISHING_BASE_URL=https://rochercybersecurite.com/api/v1
# Adresse d'expedition des SIMULATIONS de phishing — DOIT etre sur un domaine
# distinct du transactionnel (RESEND_FROM), et verifie chez Resend.
#
# Pourquoi : une bonne simulation pousse les salaries a SIGNALER le message, ces
# signalements remontent a Microsoft et Google, et ils degradent la reputation du
# domaine expediteur. L'envoyer depuis celui qui porte les reinitialisations de
# mot de passe et les factures revient a leur nuire volontairement.
#
# Retenu le 2026-08-03 : no-reply@cyberscanapp.com — ancien domaine de marque,
# deja verifie chez Resend, n'envoie plus rien. Gratuit et totalement distinct.
#
# VIDE OU MAL RENSEIGNE = AUCUNE CAMPAGNE NE PART. `verifier_domaine_expedition`
# refuse plutot que de retomber en silence sur le domaine principal. C'est
# delibere : mieux vaut un lancement bloque qu'une reputation abimee.
# Cf. docs/PHISHING_REDESIGN.md 5c.
PHISHING_FROM_EMAIL=
PHISHING_BATCH_SIZE=20
PHISHING_TRACKING_TTL_DAYS=30

# ── Presentes en PRODUCTION, absentes d'ici jusqu'au 2026-08-20 ──────────────
#
# Les trois variables ci-dessous existent dans la definition de tache ECS mais
# ne figuraient pas dans ce fichier. Quelqu'un montant son poste a partir d'ici
# obtenait donc un depot de documents silencieusement inoperant, sans message
# d'erreur : `S3_BUCKET_NAME` vide ne leve pas, elle desactive.

# Seau S3 des livrables et des documents deposes. Vide en local = pas de depot.
# Production : cybervault-rssi-deliverables-prod
S3_BUCKET_NAME=

# En-tete partage entre CloudFront et l'ALB. Il arme `_get_real_ip` : sans lui
# le garde applicatif est un no-op, et `X-Forwarded-For` redevient forgeable.
# Inutile en local, ou l'on n'est pas derriere un CDN.
ORIGIN_VERIFY_SECRET=

# Nombre de proxys de confiance devant l'application (CloudFront + ALB = 2).
# Sert a savoir combien d'entrees de `X-Forwarded-For` sont dignes de foi.
# En local, sans proxy : 0.
TRUSTED_PROXY_COUNT=0
