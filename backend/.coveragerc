# Périmètre de mesure de la couverture.
#
# RÈGLE : chaque exclusion doit avoir une raison écrite. Une exclusion sans
# justification finit par masquer un angle mort qu'on croit couvert.
#
# Historique — 2026-07-30 : plus AUCUN service n'est exclu de la mesure.
# Cinq l'étaient encore, sur la présomption qu'ils n'étaient pas testés. Mesure
# faite, quatre l'étaient déjà correctement (phishing 90 %, scan 83 %,
# public_scan 82 %, quote 75 %) : ils étaient invisibles, pas à découvert. Le
# cinquième, newsletter_email, était réellement à 25 % — le seul vrai angle mort
# du lot, et on ne le voyait pas.
# Trois autres entrées ne matchaient plus rien depuis que ces services sont
# devenus des packages (email_service/, scheduler/, phishing_templates/) et
# laissaient croire à une exclusion inexistante.
[run]
source = app
omit =
    # Migrations : du DDL généré, pas du code applicatif.
    app/alembic/*
    # Configuration de connexion : quelques lignes exécutées à l'import, sans
    # branche à tester.
    app/core/database.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
    \.\.\.
