{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LectureParLaDistributionCloudFront",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::cyberscanapp-frontend/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::328646895533:distribution/E3DFNMKIHVBDO1"
        }
      }
    }
  ]
}