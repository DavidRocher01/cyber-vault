{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FrontendBucketSeulement",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::cyberscanapp-frontend"
    },
    {
      "Sid": "ObjetsDuFrontend",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:PutObjectAcl"],
      "Resource": "arn:aws:s3:::cyberscanapp-frontend/*"
    },
    {
      "Sid": "InvalidationDeLaDistribution",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation"],
      "Resource": "arn:aws:cloudfront::328646895533:distribution/E3DFNMKIHVBDO1"
    },
    {
      "Sid": "FonctionDeRoutage",
      "Effect": "Allow",
      "Action": [
        "cloudfront:DescribeFunction",
        "cloudfront:GetFunction",
        "cloudfront:UpdateFunction",
        "cloudfront:PublishFunction",
        "cloudfront:TestFunction"
      ],
      "Resource": "arn:aws:cloudfront::328646895533:function/redirect-cyberscanapp-to-rocher"
    },
    {
      "Sid": "JetonEcrGlobal",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "DepotDImagesUnique",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:eu-west-3:328646895533:repository/cybervault-backend"
    },
    {
      "Sid": "EcsSansPortee",
      "Effect": "Allow",
      "Action": ["ecs:RegisterTaskDefinition", "ecs:DescribeTaskDefinition"],
      "Resource": "*"
    },
    {
      "Sid": "EcsPorteeAuService",
      "Effect": "Allow",
      "Action": ["ecs:UpdateService", "ecs:DescribeServices"],
      "Resource": "arn:aws:ecs:eu-west-3:328646895533:service/cybervault-prod/*"
    },
    {
      "Sid": "TacheDeMigration",
      "Effect": "Allow",
      "Action": ["ecs:RunTask", "ecs:DescribeTasks", "ecs:StopTask"],
      "Resource": [
        "arn:aws:ecs:eu-west-3:328646895533:task-definition/cybervault-backend:*",
        "arn:aws:ecs:eu-west-3:328646895533:task/cybervault-prod/*"
      ]
    },
    {
      "Sid": "PasserLesRolesDeTache",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::328646895533:role/cybervault-ecs-task-role",
        "arn:aws:iam::328646895533:role/ecsTaskExecutionRole"
      ],
      "Condition": { "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" } }
    }
  ]
}
